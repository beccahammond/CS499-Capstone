# CS499 Enhancement One - Software Design and Engineering
#
# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore, so your password never gets committed.

# Required
DB_USER=aacuser
DB_PASSWORD=

# Optional (these are the defaults)
DB_HOST=localhost
DB_PORT=27017
DB_NAME=aac
DB_COLLECTION=animals
DB_AUTH_SOURCE=admin
DB_TIMEOUT_MS=5000
APP_HOST=127.0.0.1
APP_PORT=8050
APP_DEBUG=false
LOG_LEVEL=INFO
